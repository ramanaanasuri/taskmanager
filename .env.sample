# Database
DB_NAME=taskmanager
DB_USER=taskuser
DB_PASSWORD=taskpassword
DB_ROOT_PASSWORD=rootpassword

# Secrets
JWT_SECRET=replace-with-strong-secret

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_FACEBOOK_APP_ID=
REACT_APP_OAUTH_REDIRECT=http://localhost:3000/oauth2/redirect

# App/SPA Hosts
REACT_APP_API_BASE=http://localhost:8080
SPA_HOST=http://localhost:3000

# Spring profile default (overridden by gcp override compose)
SPRING_PROFILES_ACTIVE=aws

# --- Admin visibility & AI guardrail ---
# Where signup alerts, guardrail alerts, and the 7am daily digest go.
ADMIN_ALERT_EMAIL=ranasuri@gmail.com
# Daily AI-call ceiling per non-exempt user; crossing it blocks AI (sticky).
ADMIN_AI_BLOCK_THRESHOLD=10
# Comma-separated emails never throttled (admin, family, invited testers).
ADMIN_EXEMPT_EMAILS=ranasuri@gmail.com
# Keep false while Stripe uses test keys: demo "paid" plans get no exemption.
BILLING_LIVE=false
